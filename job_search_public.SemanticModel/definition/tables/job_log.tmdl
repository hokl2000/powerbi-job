		summarizeBy: none
		sourceColumn: IsTest

		annotation SummarizationSetBy = Automatic

	partition job_log = m
		mode: import
		source =
				let
				  Kilde = Csv.Document(File.Contents("C:\Users\holge\Documents\powerbi-job-search\data\job_log_anonymised.csv"), [Delimiter = ";", Columns = 6, Encoding = 65001, QuoteStyle = QuoteStyle.None]),
				  #"Hævede overskrifter" = Table.PromoteHeaders(Kilde, [PromoteAllScalars = true]),
				  #"Ændret kolonnetype" = Table.TransformColumnTypes(#"Hævede overskrifter", {{"Sent", type date}, {"Job", type text}, {"Employer", type text}, {"Link", type text}, {"Deadline", type text}, {"Status", type text}}, "da"),
				  #"Tilføjet brugerdefineret" = Table.TransformColumnTypes(Table.AddColumn(#"Ændret kolonnetype", "DeadlineDate", each try Date.FromText([Deadline], [Format="yyyy-MM-dd"]) otherwise null), {{"DeadlineDate", type date}}),
				  #"Tilføjet brugerdefineret 1" = Table.TransformColumnTypes(Table.AddColumn(#"Tilføjet brugerdefineret", "StatusGroup", each List.First(Text.Split(List.First(Text.Split([Status], " (")), " –"))), {{"StatusGroup", type text}}),
				  #"Tilføjet brugerdefineret 2" = Table.TransformColumnTypes(Table.AddColumn(#"Tilføjet brugerdefineret 1", "IsTest", each Text.Contains([Job], " test)")), {{"IsTest", type logical}})
				in
				  #"Tilføjet brugerdefineret 2"

	annotation PBI_ResultType = Table

