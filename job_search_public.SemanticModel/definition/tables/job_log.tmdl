		annotation SummarizationSetBy = Automatic

	column Link
		dataType: string
		lineageTag: f0d7511f-8db8-4e31-8869-ac698f50a2c8
		summarizeBy: none
		sourceColumn: Link

		annotation SummarizationSetBy = Automatic

	column Deadline
		dataType: string
		lineageTag: 9330b0d2-212f-4115-831a-bd42a9ac5944
		summarizeBy: none
		sourceColumn: Deadline

		annotation SummarizationSetBy = Automatic

	column Status
		dataType: string
		lineageTag: 029fea92-9ad8-45fb-8b45-7775bc7c524d
		summarizeBy: none
		sourceColumn: Status

		annotation SummarizationSetBy = Automatic

	column DeadlineDate
		dataType: dateTime
		formatString: Long Date
		lineageTag: c1d59c20-037b-47f5-85d3-b3459fe67568
		summarizeBy: none
		sourceColumn: DeadlineDate

		variation Variation
			isDefault
			relationship: f2a66af4-bd39-40a2-b85b-ba489e0f265c
			defaultHierarchy: LocalDateTable_6becf20c-25b6-4a43-a3f1-cbe5f4c46ae2.Datohierarki

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column StatusGroup
