table job_log
	lineageTag: 490f61aa-d191-4d79-b7bf-95f99890b771

	measure Rejected = COUNTROWS(FILTER(job_log, job_log[StatusGroup] = "rejected"))
		formatString: 0
		lineageTag: 79f69e0a-a53e-46ec-b738-22ddb694a87f

	measure Applied = COUNTROWS(FILTER(job_log, job_log[StatusGroup] = "applied"))
		formatString: 0
		lineageTag: fef53203-6566-4184-b096-0931845eeabb

	measure 'Deadlines next 7 days' = COUNTROWS(FILTER(job_log, job_log[StatusGroup] = "sent" && job_log[DeadlineDate] >= TODAY() && job_log[DeadlineDate] <= TODAY()+7))
		formatString: 0
		lineageTag: d9615f30-8375-47da-8099-15e9507915d8

	measure 'Jobs from normal runs' = COUNTROWS(FILTER(job_log, job_log[IsTest] = FALSE()))
		formatString: 0
		lineageTag: 9d581e0c-3203-43e5-8bab-c2b4ffc4c384

	column Sent
		dataType: dateTime
		formatString: Long Date
		lineageTag: 0f9eb704-6bc1-4354-8ba6-c9272a4d4594
		summarizeBy: none
		sourceColumn: Sent

		variation Variation
			isDefault
			relationship: cfb4af52-79e6-4a36-acc8-7e3bad48c136
			defaultHierarchy: LocalDateTable_5a0aa072-2569-44b4-af71-aefda4ba065e.Datohierarki

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Job
